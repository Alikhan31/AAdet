# Database: use asyncpg for PostgreSQL or aiosqlite for SQLite
# PostgreSQL: postgresql+asyncpg://user:password@localhost:5432/habit_tracking
# SQLite:    sqlite+aiosqlite:///./habit_tracking.db
DATABASE_URL=sqlite+aiosqlite:///./habit_tracking.db

# JWT (generate with: openssl rand -hex 32)
SECRET_KEY=your-secret-key-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# App
APP_ENV=development

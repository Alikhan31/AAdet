# Database: use asyncpg for PostgreSQL or aiosqlite for SQLite
# PostgreSQL (Docker: postgres:5432): postgresql+asyncpg://habit:habit_secret@localhost:5432/habit_tracking
# SQLite:    sqlite+aiosqlite:///./habit_tracking.db
DATABASE_URL=sqlite+aiosqlite:///./habit_tracking.db

# JWT (generate with: openssl rand -hex 32)
SECRET_KEY=your-secret-key-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# App
APP_ENV=development

# Google OAuth (optional - get from https://console.cloud.google.com/apis/credentials)
# GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
# GOOGLE_CLIENT_SECRET=your-google-client-secret
# GOOGLE_REDIRECT_URI=http://localhost:8000/api/auth/google/callback

# AI — Grok is the default provider (get from https://console.x.ai/)
# GROK_API_KEY=xai-...
# AI_CHAT_PROVIDER=grok   # grok | claude | gemini
# ANTHROPIC_API_KEY=sk-ant-...   # fallback if Grok not set

# Email / SMTP (for email verification)
# Gmail: enable 2FA → generate App Password at https://myaccount.google.com/apppasswords
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your@gmail.com
# SMTP_PASSWORD=your-app-password
# SMTP_FROM=your@gmail.com

# Frontend URL (used in verification email links)
# FRONTEND_URL=http://localhost:3000

# Redis (enables caching + Celery background tasks)
# REDIS_URL=redis://localhost:6379/0

# ── Server production environment ────────────────────────────────────────────
# Copy this file to .env.server and fill in all values before deploying.
# Then copy to habit-tracking-back/.env as well (the api container reads it).
#
# Generate SECRET_KEY:  openssl rand -hex 32
# Generate POSTGRES_PASSWORD: openssl rand -hex 16

# ── Postgres ──────────────────────────────────────────────────────────────────
POSTGRES_PASSWORD=change_me_strong_password

# ── JWT ───────────────────────────────────────────────────────────────────────
SECRET_KEY=change_me_run_openssl_rand_hex_32
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# ── App ───────────────────────────────────────────────────────────────────────
APP_ENV=production

# Allowed browser origins for CORS (comma-separated, or * to allow all)
# Example with domain:  ALLOWED_ORIGINS=https://yourdomain.com,http://yourdomain.com
# Example with IP:      ALLOWED_ORIGINS=http://YOUR_DROPLET_IP:3000
ALLOWED_ORIGINS=*

# Frontend URL for email verification links
FRONTEND_URL=http://YOUR_DROPLET_IP:3000

# ── AI provider ───────────────────────────────────────────────────────────────
AI_CHAT_PROVIDER=gemini        # gemini | grok | claude
GEMINI_API_KEY=
GROK_API_KEY=
ANTHROPIC_API_KEY=

# ── Email / SMTP ──────────────────────────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
